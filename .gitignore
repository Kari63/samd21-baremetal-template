# .gitignore - samd21_template1 (repository root = solution level)
#
# Layered protection: folder rules catch build folders anywhere
# in the tree, and extension rules catch build artifacts
# even if they end up in the wrong folder.

# ---------------------------------------------------------------------------
# 1. Build folders at any depth (not tied to the project path)
# ---------------------------------------------------------------------------
[Dd]ebug/
[Rr]elease/
[Dd]ebug_*/
[Rr]elease_*/
[Bb]uild/
[Oo]ut/
[Oo]bj/
[Bb]in/

# ---------------------------------------------------------------------------
# 2. GCC/Atmel Studio build artifacts by file extension
# ---------------------------------------------------------------------------
# Objects and dependencies
*.o
*.obj
*.d
*.su
*.i
*.ii
*.s.tmp
# Libraries
*.a
*.lib
# Linker outputs and programming files
*.elf
*.axf
*.out
*.hex
*.ihex
*.bin
*.srec
*.s19
*.eep
*.map
*.lss
*.lst
*.sym
# Makefiles generated by Atmel Studio (created in Debug/ and Release/)
makedep.mk
*.mk

# ---------------------------------------------------------------------------
# 3. Atmel Studio 7 / Visual Studio shell
# ---------------------------------------------------------------------------
.vs/
*.atsuo
*.suo
*.user
*.cppproj.user
*.cproj.user
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
ipch/

# ---------------------------------------------------------------------------
# 4. Keil MDK (ARMClang) - parallel test environment
# ---------------------------------------------------------------------------
[Oo]bjects/
[Ll]istings/
RTE/_*/
*.uvguix.*
*.uvoptx
*.bak
*.dep
*.crf
*.lnp
*.htm
*.build_log.htm
*.iex
*.scvd
JLinkLog.txt
JLinkSettings.ini
EventRecorderStub.scvd

# ---------------------------------------------------------------------------
# 5. Debuggers and programming tools
# ---------------------------------------------------------------------------
*.jdebug
*.jdebug.user
openocd.log
*.log

# ---------------------------------------------------------------------------
# 6. Editors and operating system
# ---------------------------------------------------------------------------
# .vscode/ is kept in the repository on purpose, only caches are excluded
.vscode/ipch/
.vscode/.browse.*
# launch.json holds machine-specific absolute paths; the repository has
# launch.example.json, copy it to launch.json and fix the paths
**/.vscode/launch.json
.history/
*.swp
*~
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

# ---------------------------------------------------------------------------
# 7. Project specific: support material binaries
# ---------------------------------------------------------------------------
# Microchip errata PDF (copyright) and zip copies of the ticket folders
samd21_template1/support/*.pdf
samd21_template1/support/*.zip
